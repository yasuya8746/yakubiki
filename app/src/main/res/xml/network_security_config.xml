<?xml version="1.0" encoding="utf-8"?>
<!-- 通信は HTTPS のみ。cleartext(http://)はすべてのドメインで禁止する。domain-config で例外を作らないこと。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
